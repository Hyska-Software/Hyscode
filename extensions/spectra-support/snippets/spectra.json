{
  "Module": {
    "prefix": "module",
    "body": [
      "module ${1:name};",
      "",
      "${0}"
    ],
    "description": "Declare a Spectra module"
  },
  "Module with main": {
    "prefix": "newfile",
    "body": [
      "module ${1:name};",
      "",
      "pub fn main() {",
      "    ${0}",
      "}"
    ],
    "description": "New Spectra file with module and main"
  },
  "Main Function": {
    "prefix": "main",
    "body": [
      "pub fn main() {",
      "    ${0}",
      "}"
    ],
    "description": "Create the public main function"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:param}: ${3:int}) -> ${4:int} {",
      "    ${0}",
      "}"
    ],
    "description": "Create a function with parameters and a return type"
  },
  "Public Function": {
    "prefix": "pubfn",
    "body": [
      "pub fn ${1:name}(${2:param}: ${3:int}) -> ${4:int} {",
      "    ${0}",
      "}"
    ],
    "description": "Create a public function"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:field}: ${3:int},",
      "}"
    ],
    "description": "Declare a struct"
  },
  "Struct with impl": {
    "prefix": "structimpl",
    "body": [
      "struct ${1:Name} {",
      "    ${2:field}: ${3:int},",
      "}",
      "",
      "impl ${1:Name} {",
      "    fn new(${2:field}: ${3:int}) -> ${1:Name} {",
      "        return ${1:Name} { ${2:field}: ${2:field} };",
      "    }",
      "",
      "    fn ${4:method}(self) -> ${5:int} {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Declare a struct with an impl block"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "    ${2:Variant},",
      "}"
    ],
    "description": "Declare an enum"
  },
  "Enum with data": {
    "prefix": "enumdata",
    "body": [
      "enum ${1:Name} {",
      "    ${2:Some}(${3:int}),",
      "    ${4:None},",
      "}"
    ],
    "description": "Declare an enum with a data variant"
  },
  "Impl Block": {
    "prefix": "impl",
    "body": [
      "impl ${1:Type} {",
      "    fn ${2:method}(self) -> ${3:int} {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Create an impl block with a method"
  },
  "If Let": {
    "prefix": "iflet",
    "body": [
      "if let ${1:Variant}(${2:value}) = ${3:expr} {",
      "    ${0}",
      "}"
    ],
    "description": "Create an if let block to unpack an enum"
  },
  "If Let with Else": {
    "prefix": "ifletelse",
    "body": [
      "if let ${1:Variant}(${2:value}) = ${3:expr} {",
      "    ${4}",
      "} else {",
      "    ${0}",
      "}"
    ],
    "description": "Create an if let block with else"
  },
  "While Let": {
    "prefix": "whilelet",
    "body": [
      "while let ${1:Variant}(${2:value}) = ${3:expr} {",
      "    ${0}",
      "}"
    ],
    "description": "Create a while let loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    ${0}",
      "}"
    ],
    "description": "Create a while loop"
  },
  "Counter Loop": {
    "prefix": "for",
    "body": [
      "let ${1:i} = 0;",
      "while ${1:i} < ${2:10} {",
      "    ${0}",
      "    ${1:i} = ${1:i} + 1;",
      "}"
    ],
    "description": "Counter loop with while (classic for equivalent)"
  },
  "Do While": {
    "prefix": "dowhile",
    "body": [
      "do {",
      "    ${0}",
      "} while ${1:condition};"
    ],
    "description": "Create a do-while loop"
  },
  "Infinite Loop": {
    "prefix": "loop",
    "body": [
      "loop {",
      "    ${0}",
      "    if ${1:condition} {",
      "        break;",
      "    }",
      "}"
    ],
    "description": "Create an infinite loop with break"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:Pattern}(${3:v}) => ${4:v},",
      "    _ => ${0},",
      "}"
    ],
    "description": "Create a match expression with wildcard"
  },
  "Match Enum": {
    "prefix": "matchenum",
    "body": [
      "match ${1:value} {",
      "    ${2:Enum}::${3:VariantA} => ${4},",
      "    ${2:Enum}::${5:VariantB} => ${0},",
      "}"
    ],
    "description": "Create an exhaustive match over an enum"
  },
  "Let Binding": {
    "prefix": "let",
    "body": [
      "let ${1:name} = ${0};"
    ],
    "description": "Declare a variable"
  },
  "Import Named": {
    "prefix": "import",
    "body": [
      "import { ${1:fn_name} } from ${2:std.io};"
    ],
    "description": "Import specific functions from a module"
  },
  "Import Alias": {
    "prefix": "importas",
    "body": [
      "import ${1:std.math} as ${2:math};"
    ],
    "description": "Import a module with an alias"
  },
  "Return": {
    "prefix": "return",
    "body": [
      "return ${0};"
    ],
    "description": "Return a value"
  },
  "Print Line": {
    "prefix": "println",
    "body": [
      "println(${0});"
    ],
    "description": "Print a line (requires import std.io)"
  },
  "Async Function": {
    "prefix": "asyncfn",
    "body": [
      "pub async fn ${1:name}(${2:param}: ${3:int}) -> ${4:int} {",
      "    ${0}",
      "}"
    ],
    "description": "Create an async function"
  },
  "Async Block": {
    "prefix": "asyncblock",
    "body": [
      "let ${1:task} = async {",
      "    ${0}",
      "};"
    ],
    "description": "Create an async block"
  },
  "Await Task": {
    "prefix": "await",
    "body": [
      "let ${1:value} = await ${2:task};"
    ],
    "description": "Await a Task<T> inside an async context"
  },
  "API Handler": {
    "prefix": "apihandler",
    "body": [
      "pub fn ${1:handle}(request: std.api.http.Request) -> std.api.http.Response {",
      "    return std.api.handler.json(\"${2:{}}\");",
      "}"
    ],
    "description": "Create a synchronous spectra.api handler"
  },
  "API Async Handler": {
    "prefix": "apiasynchandler",
    "body": [
      "pub async fn ${1:handle}(request: std.api.http.Request) -> std.api.http.Response {",
      "    return std.api.handler.json(\"${2:{}}\");",
      "}"
    ],
    "description": "Create an async spectra.api handler"
  },
  "API Router GET": {
    "prefix": "apiroute",
    "body": [
      "let ${1:router} = std.api.routing.router();",
      "let ${2:route} = std.api.routing.get(${1:router}, \"${3:/health}\");",
      "${0}"
    ],
    "description": "Create a spectra.api router with a GET route"
  },
  "API CORS Policy": {
    "prefix": "apicors",
    "body": [
      "let ${1:policy} = std.api.cors.permissive();",
      "let ${2:cors} = std.api.cors.middleware(${1:policy});",
      "${0}"
    ],
    "description": "Create a CORS policy and spectra.api middleware"
  },
  "API Middleware Chain": {
    "prefix": "apimiddleware",
    "body": [
      "let ${1:chain} = std.api.middleware.chain();",
      "let ${2:next} = std.api.middleware.use_sync(${1:chain}, ${3:middleware});",
      "let ${4:response} = std.api.middleware.execute_sync(${2:next}, ${5:request}, ${6:response});",
      "${0}"
    ],
    "description": "Create a spectra.api middleware chain"
  },
  "API JSON Response": {
    "prefix": "apijson",
    "body": [
      "return std.api.handler.json(\"${1:{}}\");"
    ],
    "description": "Return a JSON Response through spectra.api"
  },
  "F-String": {
    "prefix": "fstr",
    "body": [
      "f\"${0}\""
    ],
    "description": "Create an f-string with interpolation"
  }
}
