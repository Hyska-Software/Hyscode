{
  "name": "spectra-support",
  "displayName": "SpectraLang",
  "version": "1.0.0",
  "description": "Suporte completo à linguagem SpectraLang — IntelliSense via spectra-lsp (LSP), snippets, formatação, diagnósticos e comandos spectralang (run/check/compile/lint/new)",
  "publisher": "hyscode",
  "engines": { "hyscode": ">=0.1.0" },
  "categories": ["Languages", "Snippets"],
  "keywords": ["spectra", "spectralang", "lsp", "ai", "ml", "api", "async"],
  "license": "MIT",
  "icon": "assets/spectra-icon.png",
  "activationEvents": [
    "onLanguage:spectra",
    "workspaceContains:**/*.spectra"
  ],
  "main": "main.js",
  "contributes": {
    "languages": [
      {
        "id": "spectra",
        "aliases": ["Spectra", "SpectraLang"],
        "extensions": [".spectra", ".spc"],
        "configuration": "language-configuration.json",
        "icon": "assets/spectra-file-dark.png"
      }
    ],
    "languageServers": [
      {
        "id": "spectra-lsp",
        "languageIds": ["spectra"],
        "command": "spectra-lsp",
        "args": [],
        "rootPatterns": ["spectra.toml", "Spectra.toml"],
        "initializationOptions": {
          "spectra": {
            "cliPath": "spectralang",
            "lintOnSave": true
          }
        }
      }
    ],
    "snippets": [
      { "language": "spectra", "path": "snippets/spectra.json" }
    ],
    "commands": [
      {
        "id": "spectra.run",
        "title": "Run",
        "category": "Spectra"
      },
      {
        "id": "spectra.check",
        "title": "Check (type-check)",
        "category": "Spectra"
      },
      {
        "id": "spectra.compile",
        "title": "Compile",
        "category": "Spectra"
      },
      {
        "id": "spectra.lint",
        "title": "Lint Workspace",
        "category": "Spectra"
      },
      {
        "id": "spectra.format",
        "title": "Format File",
        "category": "Spectra"
      },
      {
        "id": "spectra.newProject",
        "title": "New Project",
        "category": "Spectra"
      },
      {
        "id": "spectra.compilerActions",
        "title": "Compiler Actions...",
        "category": "Spectra"
      },
      {
        "id": "spectra.apiActions",
        "title": "API Actions...",
        "category": "Spectra"
      }
    ],
    "keybindings": [
      {
        "command": "spectra.run",
        "key": "ctrl+f5",
        "when": "editorTextFocus && editorLangId == spectra"
      },
      {
        "command": "spectra.check",
        "key": "ctrl+shift+h",
        "when": "editorTextFocus && editorLangId == spectra"
      }
    ],
    "menus": {
      "editor/context": [
        { "command": "spectra.run", "group": "1_spectra", "when": "editorLangId == spectra" },
        { "command": "spectra.check", "group": "1_spectra", "when": "editorLangId == spectra" },
        { "command": "spectra.compile", "group": "1_spectra", "when": "editorLangId == spectra" },
        { "command": "spectra.format", "group": "1_spectra", "when": "editorLangId == spectra" }
      ],
      "editor/title": [
        { "command": "spectra.run", "group": "navigation", "when": "editorLangId == spectra" },
        { "command": "spectra.check", "group": "navigation", "when": "editorLangId == spectra" }
      ],
      "commandPalette": [
        { "command": "spectra.run" },
        { "command": "spectra.check" },
        { "command": "spectra.compile" },
        { "command": "spectra.lint" },
        { "command": "spectra.format" },
        { "command": "spectra.newProject" },
        { "command": "spectra.compilerActions" },
        { "command": "spectra.apiActions" }
      ]
    },
    "statusBarItems": [
      {
        "id": "spectra-support.indicator",
        "text": "⬡ Spectra",
        "tooltip": "SpectraLang support ativo — spectra-lsp",
        "command": "spectra.compilerActions",
        "alignment": "right",
        "priority": 48
      }
    ],
    "settingsTabs": [
      {
        "id": "spectra-support.settings",
        "label": "SpectraLang",
        "icon": "code"
      }
    ],
    "configuration": {
      "title": "SpectraLang",
      "properties": {
        "spectra.cliPath": {
          "type": "string",
          "default": "spectralang",
          "description": "Caminho para o binário spectralang (deixe como 'spectralang' para usar o PATH)"
        },
        "spectra.lintOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Incluir avisos de lint ao salvar arquivos Spectra"
        },
        "spectra.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Formatar arquivos Spectra ao salvar"
        }
      }
    }
  }
}
