{
  "identifier": "main-capability",
  "description": "Main window permissions. SECURITY (Phase 1): direct plugin-fs WRITES are blocked (no fs:allow-write-file/mkdir/remove/rename/copy-file) — all filesystem mutation goes through hardened custom commands (fs.rs: canonicalize + filesystem-root guard). Plugin-fs reads remain for compatibility. Direct plugin-sql stays for the user-driven DB viewer (db-engine.ts); app state uses db.rs commands. shell git keeps args:true because git CLI args are validated in Rust (git_backend::validate_git_ref + validate_clone_url); shell_exec itself is allowlisted to git/node/npm/bun in utils.rs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-resize-dragging",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**" }]
    },
    "shell:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "git",
          "cmd": "git",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "git",
          "cmd": "git",
          "args": true
        }
      ]
    },
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "http:default",
    "http:allow-fetch",
    "http:allow-fetch-cancel",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "notification:default",
    "notification:allow-notify"
  ]
}
